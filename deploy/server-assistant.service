[Unit]
Description=Server Assistant monitoring daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server-assistant
Group=server-assistant
EnvironmentFile=/etc/server-assistant/server-assistant.env
ExecStart=/usr/local/bin/server-assistant -config /etc/server-assistant/config.yaml
Restart=on-failure
RestartSec=5s
StateDirectory=server-assistant
WorkingDirectory=/var/lib/server-assistant
StandardOutput=journal
StandardError=journal

# Deep hardening is deliberately deferred per ADR 0003.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/server-assistant

[Install]
WantedBy=multi-user.target
