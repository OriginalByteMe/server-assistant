[Unit]
Description=Server Assistant monitoring daemon
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=server-assistant
Group=server-assistant
WorkingDirectory=/opt/server-assistant
ExecStart=/opt/server-assistant/bin/server-assistant -config /etc/server-assistant/config.yaml
EnvironmentFile=-/etc/server-assistant/env
Restart=on-failure
RestartSec=5
StateDirectory=server-assistant
StandardOutput=journal
StandardError=journal

# Deep hardening is deliberately deferred per ADR 0003; this is the subset
# that costs nothing functionally.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/server-assistant

[Install]
WantedBy=multi-user.target
